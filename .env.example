# Скопіюйте цей файл у .env:  cp .env.example .env   (Windows: copy .env.example .env)
# Файл .env у .gitignore — НЕ комітьте свій ключ.

# Обов'язково: безкоштовний ключ з https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

LLM_MODEL=gemini-3.5-flash-lite

# Необов'язково: пауза між кейсами в check.py, секунд (за замовчуванням 4.5).
# Зменшуйте, лише якщо не отримуєте помилок 429 (забагато запитів).
# CHECK_DELAY=4.5

# Необов'язково: інша OpenAI-сумісна адреса API (за замовчуванням Gemini).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
